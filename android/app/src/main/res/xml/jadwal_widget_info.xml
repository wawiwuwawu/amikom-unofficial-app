<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 3x1 (API 31+) dengan fallback minWidth/minHeight untuk perangkat
     lama. Tick periodik minimum sistem (30 menit): provider re-render dari
     SharedPreferences murni (baca jadwal_json, pilih baris tanggal perangkat)
     sehingga pergantian hari terjadi tanpa membuka app — bukan polling
     jaringan, biaya baterai dapat diabaikan. App juga mendorong update
     langsung tiap fetch agenda berhasil / app dibuka. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="60dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/jadwal_widget"
    android:widgetCategory="home_screen" />
